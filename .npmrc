# npm のサプライチェーン対策（webサイト/plans/2026-11-09-security-watch.md の層 0・0-1）
# インストール時に依存のスクリプト（preinstall・install・postinstall・prepare）を動かさない。
# npm run の前後フック（pre*・post*）も止まる。名指しした npm run <script> 自体は動く
ignore-scripts=true
# 公開から 7 日経っていない版を入れない（npm 11.x 以降。それより前の npm では無視される）。
# 急ぎの修正だけは、そのパッケージに限って --min-release-age-exclude=<名前> で外す（計画の §3.3）
min-release-age=7
# git や GitHub を直接指した依存を入れない
allow-git=none
